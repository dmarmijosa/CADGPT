<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <!-- CAD Engine Elevated MSI Installer with System PATH and ONLOGON Scheduled Task -->
    <Package Name="CAD Engine"
             Manufacturer="CAD Engine"
             Version="0.1.0"
             UpgradeCode="8E9B6A15-9E62-4C7D-9A92-F1C6DF064F22"
             Scope="perMachine"
             InstallerVersion="500">

        <SummaryInformation Description="CAD Engine Background Agent and CLI"
                            Manufacturer="CAD Engine" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Source directory for payload files, defaults to ..\..\dist\cadengine -->
        <?ifndef SourceDir?>
        <?define SourceDir = "..\..\dist\cadengine"?>
        <?endif?>

        <!-- Installation Directory: %ProgramFiles%\CAD Engine\ -->
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="CAD Engine">
                <!-- Primary Executable -->
                <Component Id="CadEngineExecutable" Guid="4D4B1F8E-8A33-4C82-9471-965F2D99E3A1" Bitness="always64">
                    <File Id="CadEngineExe" Source="$(var.SourceDir)\cadengine.exe" KeyPath="yes" />
                </Component>

                <!-- Backward Compatibility Alias -->
                <Component Id="CadGptAgentAlias" Guid="5E5C2F9F-9B44-4D93-A582-A76F3E00F4B2" Bitness="always64">
                    <File Id="CadGptAgentExe" Source="$(var.SourceDir)\cadgpt-agent.exe" KeyPath="yes" />
                </Component>

                <!-- System-wide PATH Environment Registration -->
                <Component Id="PathEnvironment" Guid="A3E8B38C-942C-4DF7-A0E1-E92671DB3C01" Bitness="always64" KeyPath="yes">
                    <Environment Id="UpdatePath"
                                 Name="PATH"
                                 Value="[INSTALLFOLDER]"
                                 Permanent="no"
                                 Part="last"
                                 Action="set"
                                 System="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <!-- Feature Tree -->
        <Feature Id="MainFeature" Title="CAD Engine" Level="1">
            <ComponentRef Id="CadEngineExecutable" />
            <ComponentRef Id="CadGptAgentAlias" />
            <ComponentRef Id="PathEnvironment" />
        </Feature>

        <!-- CustomActions for ONLOGON Scheduled Task Registration and Removal -->
        <CustomAction Id="RegisterScheduledTask"
                      Directory="INSTALLFOLDER"
                      Execute="deferred"
                      Impersonate="no"
                      ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Create /TN &quot;CADEngineAgent&quot; /TR &quot;\&quot;[INSTALLFOLDER]cadengine.exe\&quot;&quot; /SC ONLOGON /RL LIMITED /F"
                      Return="ignore" />

        <CustomAction Id="UnregisterScheduledTask"
                      Directory="INSTALLFOLDER"
                      Execute="deferred"
                      Impersonate="no"
                      ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;CADEngineAgent&quot; /F"
                      Return="ignore" />

        <!-- Execution Sequence -->
        <InstallExecuteSequence>
            <Custom Action="UnregisterScheduledTask" Before="RemoveFiles" Condition="Installed AND (REMOVE=&quot;ALL&quot; OR UPGRADINGPRODUCTCODE)" />
            <Custom Action="RegisterScheduledTask" After="InstallFiles" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
        </InstallExecuteSequence>
    </Package>
</Wix>
